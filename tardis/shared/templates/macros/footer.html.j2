<footer class="brand-footer">
  <div class="brand-footer-inner">
    <div class="footer-left">
      {% if footer.get("unit_label") %}
      <strong class="footer-brand-name-text">{{ footer.get("brand_name") or brand.get("display_name", "") }}</strong>
      <span class="footer-brand-line-text">{{ footer["unit_label"] }}</span>
      {% endif %}
      {% if footer.get("show_contact") %}
      <span class="footer-contact-line">
        {% if footer.get("site") %}{{ footer["site"] }}{% endif %}
        {% if footer.get("mail") %} &middot; {{ footer["mail"] }}{% endif %}
        {% if footer.get("phone") %} &middot; {{ footer["phone"] }}{% endif %}
      </span>
      {% endif %}
    </div>
    <div class="footer-center footer-page-number-placeholder">
      <!-- Pagina X de Y is stamped here by pikepdf post-processing -->
    </div>
    <div class="footer-right">
      {% if footer.get("right_html") %}
        {{ footer["right_html"] | safe }}
      {% elif footer.get("tagline") %}
        {{ footer["tagline"] }}
      {% endif %}
    </div>
  </div>
</footer>
