/*
 * Color Variables:
 * Fondo principal: #1e1e1e
 * Fondo secundario: #2a2a2a
 * Texto: #e0e0e0
 * Acento: #0a66c2
 * Error: #d9534f
 * Warning: #f0ad4e
 */

/* QMainWindow */
QMainWindow {
    background-color: #1e1e1e;
    color: #e0e0e0;
}

/* QMenuBar & QMenu */
QMenuBar {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border-bottom: 1px solid #3a3a3a;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    margin: 2px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #0a66c2;
    color: #ffffff;
}

QMenu {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #0a66c2;
    color: #ffffff;
}

/* QStatusBar */
QStatusBar {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border-top: 1px solid #3a3a3a;
}

/* QStatusBar object names for different states */
QStatusBar#status-error {
    color: #d9534f;
    font-weight: bold;
}

QStatusBar#status-warning {
    color: #f0ad4e;
    font-weight: bold;
}

QStatusBar#status-info {
    color: #0a66c2;
    font-weight: normal;
}

QStatusBar#status-success {
    color: #5cb85c;
    font-weight: bold;
}

/* QTableWidget & QTableView */
QTableView, QTableWidget {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #3a3a3a;
    gridline-color: #3a3a3a;
    selection-background-color: #0a66c2;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #2a2a2a;
    color: #e0e0e0;
    padding: 4px;
    border: 1px solid #3a3a3a;
}

QHeaderView {
    background-color: #2a2a2a;
}

QTableCornerButton::section {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
}

/* QPushButton */
QPushButton {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border: 1px solid #3a3a3a;
    padding: 6px 12px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #3a3a3a;
    border-color: #0a66c2;
}

QPushButton:pressed {
    background-color: #0a66c2;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #1a1a1a;
    color: #6a6a6a;
    border-color: #2a2a2a;
}

/* QLineEdit & QTextEdit */
QLineEdit, QTextEdit {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 6px;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #0a66c2;
}

/* QComboBox */
QComboBox {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 6px;
}

QComboBox:focus {
    border: 1px solid #0a66c2;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;
    border-left-width: 1px;
    border-left-color: #3a3a3a;
    border-left-style: solid;
}

QComboBox QAbstractItemView {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border: 1px solid #3a3a3a;
    selection-background-color: #0a66c2;
    selection-color: #ffffff;
}

/* Custom error/success labels */
QLabel#error-label {
    color: #d9534f;
    font-weight: bold;
}

QLabel#success-label {
    color: #5cb85c;
    font-weight: bold;
}
