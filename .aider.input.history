+En cada comando que use client.table(), verificar si está resuelta. Ejemplo para el comando read: @app.command()
+def read(
+    table: str = typer.Option(..., help="Nombre o ID de la tabla"),
+    base_id: Optional[str] = typer.Option(None, envvar="NOCO_BASE_ID", help="ID de la base de datos"),
+    # ... otros opciones
+):
+    client = get_client(base_url, token, base_id)
+    table_obj = client.table(table, base_id=base_id)
+    
+    # Verificar si la tabla está no resuelta
+    if table_obj.is_unresolved():
+        result = table_obj.meta()  # Devuelve NocoResult.fail
+        print_result(result)
+        raise typer.Exit(1)
+    
+    # Continuar con la lógica normal...
+    result = table_obj.read(params)
+    print_result(result) 

